def diagonal_traverse(mat):
    way = []
    lst = []
    for i in range(0, len(mat) + len(mat[0]) - 1):
        for num1 in range(0, i+1):
            num2 = i - num1
            if num1 < len(mat) and num2 < len(mat[0]):
                way.append(mat[num1][num2])
        if i % 2 == 0:
            way = way[::-1]
        for x in way:
            lst.append(x)
        way = []
    return lst
